FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv
WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LITELLM_LOCAL_MODEL_COST_MAP=True \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH" \
    TREND_RADAR_DATA_DIR=/data

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --extra web --no-dev --no-install-project

COPY trendradar/ ./trendradar/
COPY mcp_server/ ./mcp_server/
COPY LICENSE ./LICENSE
COPY config/ ./config/
COPY docs/index.html ./docs/index.html
COPY docs/assets/ ./docs/assets/
COPY docker/web-entrypoint.sh docker/web-healthcheck.py /usr/local/bin/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --extra web --no-dev && \
    useradd --uid 10001 --create-home radar && \
    mkdir -p /data && chown radar:radar /data && \
    chmod 755 /usr/local/bin/web-entrypoint.sh

USER radar
EXPOSE 18765
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "/usr/local/bin/web-healthcheck.py"]
ENTRYPOINT ["/usr/local/bin/web-entrypoint.sh"]
